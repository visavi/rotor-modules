{
    "paths": {
        "/offers": {
            "get": {
                "tags": [
                    "Предложения и проблемы"
                ],
                "summary": "Список предложений или проблем",
                "operationId": "getOffers",
                "security": [
                    {
                        "BearerToken": []
                    },
                    []
                ],
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "description": "Раздел: предложения или проблемы",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "offer",
                                "issue"
                            ],
                            "default": "offer"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/Sort"
                    },
                    {
                        "$ref": "#/components/parameters/PerPage"
                    },
                    {
                        "$ref": "#/components/parameters/Page"
                    },
                    {
                        "$ref": "#/components/parameters/Order"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Offer"
                                            }
                                        },
                                        "links": {
                                            "$ref": "#/components/schemas/PaginationLinks"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/PaginationMeta"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Предложения и проблемы"
                ],
                "summary": "Создание записи",
                "description": "Требует токен. Медиа прикладываются заранее через POST /files с type=offers и id=0",
                "operationId": "createOffer",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "type",
                                    "title",
                                    "text"
                                ],
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "offer",
                                            "issue"
                                        ]
                                    },
                                    "title": {
                                        "type": "string"
                                    },
                                    "text": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Запись создана",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "offer": {
                                            "$ref": "#/components/schemas/Offer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Токен не передан"
                    },
                    "401": {
                        "description": "Неверный токен"
                    },
                    "422": {
                        "description": "Не хватает баллов, антифлуд или текст не прошёл проверку"
                    },
                    "429": {
                        "description": "Превышен общий лимит запросов"
                    }
                }
            }
        },
        "/offers/{id}": {
            "get": {
                "tags": [
                    "Предложения и проблемы"
                ],
                "summary": "Запись с комментариями",
                "description": "Токен необязателен: гость читает запись, авторизованному дополнительно приходит его голос в data.vote.value.\nКомментарии отдаются страницей, лентой по дате: у ответа есть parent_id и краткий контекст родителя в parent.\n",
                "operationId": "getOffer",
                "security": [
                    {
                        "BearerToken": []
                    },
                    []
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/PerPage"
                    },
                    {
                        "$ref": "#/components/parameters/Page"
                    },
                    {
                        "$ref": "#/components/parameters/Order"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Offer"
                                        },
                                        "comments": {
                                            "type": "object",
                                            "description": "Комментарии записи со своей пагинацией",
                                            "properties": {
                                                "data": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "#/components/schemas/Comment"
                                                    }
                                                },
                                                "links": {
                                                    "$ref": "#/components/schemas/PaginationLinks"
                                                },
                                                "meta": {
                                                    "$ref": "#/components/schemas/PaginationMeta"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Запись не найдена"
                    }
                }
            },
            "patch": {
                "tags": [
                    "Предложения и проблемы"
                ],
                "summary": "Редактирование своей записи",
                "description": "Требует токен. Решённую запись править нельзя",
                "operationId": "updateOffer",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "type",
                                    "title",
                                    "text"
                                ],
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "offer",
                                            "issue"
                                        ]
                                    },
                                    "title": {
                                        "type": "string"
                                    },
                                    "text": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Запись изменена",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "offer": {
                                            "$ref": "#/components/schemas/Offer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Токен не передан"
                    },
                    "401": {
                        "description": "Неверный токен"
                    },
                    "404": {
                        "description": "Запись не найдена или принадлежит другому пользователю"
                    },
                    "422": {
                        "description": "Запись уже решена или данные не прошли проверку"
                    },
                    "429": {
                        "description": "Превышен общий лимит запросов"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Offer": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "offer",
                            "issue"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "wait",
                            "process",
                            "done",
                            "cancel"
                        ]
                    },
                    "title": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string",
                        "format": "uri"
                    },
                    "breadcrumbs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string"
                                },
                                "url": {
                                    "type": "string",
                                    "format": "uri"
                                }
                            }
                        }
                    },
                    "rating": {
                        "type": "integer"
                    },
                    "vote": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string"
                            },
                            "id": {
                                "type": "integer"
                            },
                            "value": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "enum": [
                                    "+",
                                    "-",
                                    null
                                ]
                            },
                            "own": {
                                "type": "boolean"
                            }
                        }
                    },
                    "closed": {
                        "type": "boolean"
                    },
                    "comments_count": {
                        "type": "integer"
                    },
                    "user": {
                        "$ref": "#/components/schemas/Author"
                    },
                    "media": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/File"
                        }
                    },
                    "files": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/File"
                        }
                    },
                    "reply": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "description": "Официальный ответ администрации, null — ответа ещё нет",
                        "properties": {
                            "text": {
                                "type": "string"
                            },
                            "user": {
                                "$ref": "#/components/schemas/Author"
                            },
                            "answered_at": {
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                }
            }
        }
    }
}
